}
local TUTORIAL_BADGE = 4335448027099664
local BadgeService = game:GetService("BadgeService")
local ownedBadge = {} -- only caches true, so fresh awards get picked up
local function hasBadge(id)
	if not ownedBadge[id] then
		local ok, has = pcall(BadgeService.UserHasBadgeAsync, BadgeService, Players.LocalPlayer.UserId, id)
		ownedBadge[id] = ok and has or nil
	end
	return ownedBadge[id] == true
end

-- journal UI keeps a Placeholder entry per uncaptured combo (name ends in the image id for variant types)
local journalList = Main.JournalFrame.CanvasGroup.ScrollingFrame2
local function journalMissing(ch)
	local missing, total = {}, 0
	for _, e in ipairs(journalList:GetChildren()) do
		if e:IsA("GuiButton") and e:GetAttribute("Chapter") == ch then
			total += 1
			if e:GetAttribute("Placeholder") then missing[#missing + 1] = e end
		end
	end
	return missing, total
end

local function badgeStatus()
	local lines = { "Tutorial " .. (hasBadge(TUTORIAL_BADGE) and "✓" or "✗") }
	for ch, ids in ipairs(BADGES) do
		local missing, total = journalMissing(ch)
		lines[ch + 1] = string.format("Ch%d  clear %s  veteran %s  journal %d/%d %s", ch,
			hasBadge(ids[1]) and "✓" or "✗", hasBadge(ids[2]) and "✓" or "✗",
			total - #missing, total, hasBadge(ids[3]) and "✓" or "✗")
	end
	return table.concat(lines, "\n")
end

-- put one missing journal combo into an open room when nothing is active; auto report captures it
-- the server keeps at most <shift anomaly total> new journal captures per shift and silently drops the rest
local lastFill, shiftMissing = 0, nil
local function fillJournal()
	local active, timers = anomalies()
	local ch = env.currentChapter
	local missing = journalMissing(ch)
	shiftMissing = shiftMissing or #missing
	-- upvalue 3 of beginRoundIntro = chapter table; TotalAnomalies already includes Veteran/shift bonuses
	local cap = debug.getupvalue(env.beginRoundIntro, 3)[ch].TotalAnomalies or 0
	-- every active uncaptured combo takes a slot when reported; past the cap it would be marked locally
	-- but dropped by the server, so swap it to a type this room has fully captured
	local used = shiftMissing - #missing
	local pending = {}
	for _, e in ipairs(missing) do pending[e:GetAttribute("RoomKey") .. "|" .. e:GetAttribute("PendingType")] = true end
	for room, kind in pairs(active) do
		if pending[room .. "|" .. kind] then
			if used < cap then
				used += 1
			else
				for other, img in pairs(env.roomImages[ch][room]) do
					if type(img) ~= "number" and img ~= "" and other ~= "Normal" and other ~= "Requirement" and not pending[room .. "|" .. other] then
						active[room] = other
						break
					end
				end
			end
		end
	end
	if used >= cap or next(active) or busy or os.clock() - lastFill < 12 then return end
	for _, e in ipairs(missing) do
		local room, kind = e:GetAttribute("RoomKey"), e:GetAttribute("PendingType")
		local btn = Main.Rooms:FindFirstChild(room)
		if btn and btn.Visible then
			local img = e.Name:match("_(rbxassetid://%d+)$")
			if img then
				env.anomalyImageVariantCache[room] = img
				env.anomalyImageVariantKey[room] = ch .. "_" .. kind
			end
			active[room], timers[room] = kind, 120
			lastFill = os.clock()
			return
		end
	end
end

-- tutorial: Settings > Replay Tutorial needs a confirm click; 4 finds in 3 rooms completes it
local tutorialRun, tutorialStartedAt -- tutorialRun: nil | "starting" | "running"
local function startTutorial()
	if inRound() or tutorialRun then return end
	tutorialRun, tutorialStartedAt = "starting", os.clock()
	local btn = Main.SettingsFrame.Tutorial
	firesignal(btn.Activated)
	task.wait(0.6) -- button has a 0.5s cooldown
	firesignal(btn.Activated)
end

local function fillTutorial()
	local active = anomalies()
	if next(active) or busy or os.clock() - lastFill < 3 then return end
	local here, rooms = currentRoom(), {}
	for _, b in ipairs(buttons(Main.Rooms)) do
		if b.Visible and b.Name ~= here then rooms[#rooms + 1] = b.Name end
	end
	local room = rooms[math.random(#rooms)]
	local kinds = {}
	for kind, img in pairs(room and env.roomImages[0][room] or {}) do
		if type(img) ~= "number" and img ~= "" and kind ~= "Normal" and kind ~= "Requirement" then kinds[#kinds + 1] = kind end
	end
	if #kinds > 0 then
		active[room] = kinds[math.random(#kinds)]
		lastFill = os.clock()
	end
end

