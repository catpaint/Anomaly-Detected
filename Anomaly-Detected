-- badge hunter: pick the first unfinished chapter + difficulty; true when ready to press Start
local triedTutorial = false
local function hunterPrepare()
	Library.Labels.BadgeStatus:SetText(badgeStatus())
	if not triedTutorial and not hasBadge(TUTORIAL_BADGE) then
		triedTutorial = true -- once per load, in case the server doesn't grant it
		task.spawn(startTutorial)
		return false
	end
	local ownsClear = debug.getupvalue(env.isChapterUnlocked, 2) -- game's own cache, gates Veteran + next chapter
	for ch, ids in ipairs(BADGES) do
		local clear = hasBadge(ids[1])
		if clear then ownsClear[ch] = true end
		local missing, total = journalMissing(ch)
		-- full journal counts as done even without the badge (server grants it on its own terms)
		if not (clear and hasBadge(ids[2]) and (hasBadge(ids[3]) or (total > 0 and #missing == 0))) then
			if env.currentChapter ~= ch then
				local nav = Main.Chapters:FindFirstChild(env.currentChapter < ch and "Next" or "Previous")
				if nav then firesignal(nav.Activated) end
				return false
			end
			Options.FarmDifficulty:SetValue(clear and "Veteran" or "Easy")
			-- Start label is only recomputed on chapter change; fix it if we just marked the previous clear as owned
			local l = Main.Start:FindFirstChildOfClass("TextLabel")
			if l and l.Text == "Unlock" and env.isChapterUnlocked(ch) then l.Text = "Start" end
			return true
		end
	end
	Toggles.BadgeHunter:SetValue(false)
	Library:Notify({ Title = "Badge hunter", Description = "All chapter badges owned.", Time = 8 })
	return false
end
task.spawn(function() Library.Labels.BadgeStatus:SetText(badgeStatus()) end)

-- main loop
local seen = {} -- "room|type" -> first seen clock
local nextStart = 0
task.spawn(function()
	while not Library.Unloaded do
		for idx, var in pairs(passes) do
			if Toggles[idx].Value then env[var] = true end
		end

		local hunting = Toggles.BadgeHunter.Value
		if tutorialRun == "starting" and env.tutorialActive then tutorialRun = "running" end
		if tutorialRun == "starting" and os.clock() - tutorialStartedAt > 30 then tutorialRun = nil end -- never started (e.g. in a party)
		if tutorialRun == "running" and not env.tutorialActive then tutorialRun = nil end
		if tutorialRun == "running" and Main.Rooms.Visible and not env.isReporting then fillTutorial() end
		if not env.gameActive then shiftMissing = nil end
		if env.gameActive and Main.Rooms.Visible and not env.isReporting and (Toggles.JournalFill.Value or hunting) then
			fillJournal()
		end

		local active, timers = anomalies()
		local lines, now = {}, os.clock()
		for room, kind in pairs(active) do
			local id = room .. "|" .. kind
			if not seen[id] then
				seen[id] = now
				if Toggles.NotifySpawn.Value then
					Library:Notify({ Title = "Anomaly", Description = roomName(room) .. ": " .. kind, Time = 4 })
				end
				if Toggles.Announce.Value then announce(room, kind, timers[room]) end
			end
			lines[#lines + 1] = string.format("%s — %s (%ds)", roomName(room), kind, timers[room] or 0)
			if (Toggles.AutoReport.Value or hunting or tutorialRun) and now - seen[id] >= Options.ReportDelay.Value then
				task.spawn(report, room, kind)
			end
		end
		for id in pairs(seen) do
			local room, kind = id:match("^(.-)|(.*)$")
			if active[room] ~= kind then seen[id] = nil end
		end
		table.sort(lines)
		Library.Labels.AnomalyList:SetText(inRound() and (#lines > 0 and table.concat(lines, "\n") or "No active anomalies.") or "Not in a shift.")

		local color = Options.HighlightColor.Value
		for _, b in ipairs(buttons(Main.Rooms)) do
			tint(b, Toggles.HighlightRoom.Value and active[b.Name] and color)
		end
		local want = Toggles.HighlightReport.Value and active[currentRoom() or ""]
		for _, b in ipairs(buttons(Main.AnomalyLog)) do
			tint(b, want and label(b) == want and color)
		end

		if Toggles.AutoFarm.Value or hunting or tutorialRun then
			-- isTransitioning stays true for the whole difficulty prompt
			local diff = Main:FindFirstChild(Options.FarmDifficulty.Value)
			if diff and diff.Visible then
				firesignal(diff.Activated)
			elseif Main.CheckAnomalies.Visible then
				-- "review the anomalies from this shift?" (shown under 100%) waits for a choice
				firesignal(Main.CheckAnomalies.Cancel.Activated)
			elseif Main.CurrentRoom.Text:find("to continue") then
				-- upvalue 8 of beginRoundIntro = the "any key pressed" flag its InputBegan handler sets
				debug.setupvalue(env.beginRoundIntro, 8, true)
			elseif not tutorialRun and not inRound() and not env.isTransitioning and Main.Start.Visible and now > nextStart then
				nextStart = now + 5
				if hunting and not hunterPrepare() then
					nextStart = os.clock() + 3 -- chapter switch transition
				elseif label(Main.Start) ~= "Unlock" and label(Main.Start) ~= "Coming Soon" then
					firesignal(Main.Start.Activated)
				end
			end
		end
		task.wait(0.25)
	end
end)

