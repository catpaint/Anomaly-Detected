local function inRound()
	return env.gameActive or env.tutorialActive
end

-- upvalues of spawnAnomalyLoop: 8 = active anomalies, 9 = seconds until each one moves
-- the tutorial keeps its own global table and has no timers
local function anomalies()
	if env.tutorialActive then return env.tutorialActiveAnomalies or {}, {} end
	return debug.getupvalue(env.spawnAnomalyLoop, 8) or {}, debug.getupvalue(env.spawnAnomalyLoop, 9) or {}
end

local function roomName(key)
	local texts = env.roomTexts and env.roomTexts[env.currentChapter]
	return texts and texts[key] or key
end

local function buttons(frame)
	local t = {}
	for _, b in ipairs(frame:GetChildren()) do
		if b:IsA("GuiButton") and b.Name ~= "Template" and b.Name ~= "Global" and b.Name ~= "Area" then t[#t + 1] = b end
	end
	return t
end

local function label(b)
	local l = b:FindFirstChildOfClass("TextLabel")
	return l and l.Text
end

local function logButton(kind)
	for _, b in ipairs(buttons(Main.AnomalyLog)) do
		if label(b) == kind then return b end
	end
end

local function waitIdle(timeout)
	local t = os.clock() + (timeout or 10)
	while (env.isReporting or env.isTransitioning) and os.clock() < t do task.wait(0.1) end
	return not (env.isReporting or env.isTransitioning)
end

-- selected room's label turns white (see onRoomButtonActivated)
local function isSelected(btn)
	local l = btn:FindFirstChildOfClass("TextLabel")
	return l and l.TextColor3 == Color3.new(1, 1, 1)
end

local function currentRoom()
	for _, b in ipairs(buttons(Main.Rooms)) do
		if isSelected(b) then return b.Name end
	end
end

local busy = false
local function report(room, kind)
	if busy or not inRound() then return end
	busy = true
	local ok, err = pcall(function()
		local roomBtn, btn = Main.Rooms:FindFirstChild(room), logButton(kind)
		if not (roomBtn and btn) or not waitIdle() then return end
		if not isSelected(roomBtn) then
			firesignal(roomBtn.Activated)
			task.wait(0.2)
			if not waitIdle() or not isSelected(roomBtn) then return end
		end
		if anomalies()[room] ~= kind then return end -- moved while we were switching
		firesignal(btn.Activated)
		waitIdle(15)
	end)
	if not ok then warn("[Eternal] report failed:", err) end
	busy = false
end

-- chat
local whisperChannels = {}
local function whisperChannel(plr)
	local ch = whisperChannels[plr.UserId]
	if ch and ch.Parent then return ch end
	ch = game:GetService("RobloxReplicatedStorage").ExperienceChat.WhisperChat:InvokeServer(plr.UserId)
	whisperChannels[plr.UserId] = ch
	return ch
end

local function announce(room, kind, timeLeft)
	local vars = { anomaly = kind, report = kind, room = roomName(room), time = tostring(timeLeft or 0) }
	local msg = Options.AnnounceText.Value:gsub("{(%w+)}", vars)
	if Toggles.AnnouncePublic.Value then
		task.spawn(pcall, function() TextChatService.TextChannels.RBXGeneral:SendAsync(msg) end)
	end
	for plr, on in pairs(Options.AnnounceWhisper.Value) do
		plr = typeof(plr) == "Instance" and plr or Players:FindFirstChild(tostring(plr))
		if on and plr and plr.Parent then
			task.spawn(function()
				local ok, err = pcall(function() whisperChannel(plr):SendAsync(msg) end)
				if not ok then warn("[Eternal] whisper to", plr.Name, "failed:", err) end
			end)
		end
	end
end

